# Voice used by macOS `say` (list with: say -v '?')
VOICE=Daniel
# Starting speech rate in words per minute (auto-raised per scene if the VO does not fit its time window)
# Use about 150 for the IBM Bob client demo (human pace)
SPEECH_RATE=185
# Output frame rate
FPS=24
# Log level: DEBUG, INFO, WARN, ERROR
LOG_LEVEL=INFO
# Script table to build from (default: HexStrike_AV_script_v1.md)
# SCRIPT_FILE=IBM_Bob_Client_Demo_script_v2.md
# Working folder for intermediate audio (default: build)
# BUILD_DIR=build_bob
