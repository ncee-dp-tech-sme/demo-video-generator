# Demo Narrative Builder - runtime settings. Copy to .env (the installer does this for you).
# Real environment variables take precedence over values in this file.

# Log level: DEBUG, INFO, WARN, ERROR (DEBUG also shows detailed error messages)
LOG_LEVEL=INFO
# Folder (relative to the current workspace) that receives one sub-folder per source document
OUTPUT_DIR=narratives
# Network timeout for fetching a hosted blog, in seconds
INGEST_TIMEOUT_SECONDS=20
# Maximum size of a downloaded page or an input file, in bytes (default 10 MiB)
INGEST_MAX_BYTES=10485760
# Maximum number of PDF pages that are read
INGEST_MAX_PAGES=300
# Maximum number of HTTP redirects that are followed (each hop is re-validated)
INGEST_MAX_REDIRECTS=5
# User-Agent header sent when fetching a blog
INGEST_USER_AGENT=DemoNarrativeBuilder/1.0
# Warn when the extracted text has fewer words than this (scanned PDF, JavaScript-rendered page, ...)
MIN_WORDS_WARN=150
# Speaking pace used by validate_script.py to check that voice-over fits each scene window
SPEECH_WPM=150
# Allowed deviation of the script runtime from the target runtime, in seconds
RUNTIME_TOLERANCE_SECONDS=10

# --- Step 9 (video production), skill narrative-09-video-production ---
# Folder with the Demobuilder pipeline files demo_common.py, build_audio.py and build_video.py (absolute path).
# Empty (or no .env file at all) = the pipeline/ folder of this installation, which ships all of these files.
DEMOBUILDER_DIR=
# Python that has pillow, numpy, imageio-ffmpeg and python-dotenv;
# empty = <DEMOBUILDER_DIR>/.venv/bin/python, else the installer's .venv/bin/python, else the Python that runs the tools
PIPELINE_PYTHON=
# macOS `say` voice for the voice-over
VOICE=Daniel
# Frames per second of the rendered video
FPS=24

